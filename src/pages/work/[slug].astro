---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map((cs) => ({
    params: { slug: cs.slug },
    props: { cs }
  }));
}

const { cs } = Astro.props;
const { Content } = await cs.render();
---
<Layout title={`${cs.data.title} — Heurystics`} description={cs.data.summary} current="work">
  <section class="page-head wrap" style="border-top:none;">
    <div class="section-label">// case study</div>
    <h1 class="page-title">{cs.data.title}</h1>
    <div class="status-pill"><span class="dot"></span>{cs.data.statusLabel}</div>
  </section>

  {cs.data.stats && (
    <section style="padding-top:0;">
      <div class="wrap narrow">
        <div class="stat-row">
          {cs.data.stats.map((stat) => (
            <div class="stat">
              <div class="n">{stat.value}</div>
              <div class="l">{stat.label.toUpperCase()}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {cs.data.videoUrl && (
    <section>
      <div class="wrap narrow">
        <div class="video-wrap">
          <iframe src={cs.data.videoUrl} frameborder="0" allowfullscreen></iframe>
        </div>
      </div>
    </section>
  )}

  <section class={cs.data.stats ? '' : ''}>
    <div class="wrap narrow prose">
      <Content />
    </div>
  </section>

  {cs.data.links && cs.data.links.length > 0 && (
    <section>
      <div class="wrap narrow">
        <h2 class="h">Links</h2>
        <div class="link-list">
          {cs.data.links.map((link) => (
            <a href={link.url} target="_blank" rel="noopener" class="btn-ghost">{link.label}</a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section>
    <div class="wrap narrow">
      <h2 class="h">Stack</h2>
      <div class="stack-tags">
        {cs.data.stack.map((tech) => <span class="tag">{tech}</span>)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head { padding: 64px 0 24px; }
  h1.page-title { font-family: var(--display); font-weight: 600; font-size: clamp(30px, 5vw, 44px); max-width: 20ch; margin: 0 0 22px; }
  .status-pill { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 12px; color: var(--accent); border: 1px solid var(--accent-dim); border-radius: 20px; padding: 6px 14px; }
  .status-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

  .stat-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
  .stat { background: var(--panel); padding: 22px 20px; }
  .stat .n { font-family: var(--display); font-size: 26px; font-weight: 600; color: var(--accent); }
  .stat .l { font-family: var(--mono); font-size: 11.5px; color: var(--text-dim); margin-top: 6px; }
  @media (max-width: 680px) { .stat-row { grid-template-columns: 1fr; } }

  .video-wrap { position: relative; padding-top: 56.25%; border-radius: 6px; overflow: hidden; border: 1px solid var(--border); }
  .video-wrap iframe { position: absolute; top:0; left:0; width:100%; height:100%; }

  h2.h { font-family: var(--display); font-weight: 600; font-size: 20px; margin: 0 0 16px; }
  .link-list, .stack-tags { display: flex; gap: 10px; flex-wrap: wrap; }
  .stack-tags .tag { font-family: var(--mono); font-size: 12px; color: var(--text-muted); border: 1px solid var(--border); border-radius: 3px; padding: 6px 12px; }

  .prose { color: var(--text-muted); font-size: 16px; }
  .prose :global(h2) { font-family: var(--display); color: var(--text); font-size: 20px; font-weight: 600; margin: 36px 0 14px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { margin: 0 0 16px; }
  .prose :global(ul) { padding-left: 20px; margin: 0 0 16px; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(li strong) { color: var(--text); }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 12px 0 20px; }
  .prose :global(tr) { border-top: 1px solid var(--border); }
  .prose :global(td), .prose :global(th) { padding: 10px 12px 10px 0; font-size: 14.5px; text-align: left; }
  .prose :global(th) { color: var(--text-dim); font-family: var(--mono); font-weight: 500; font-size: 12px; }
  .prose :global(code) { font-family: var(--mono); background: var(--panel); padding: 2px 6px; border-radius: 3px; font-size: 13px; color: var(--accent); }
</style>
