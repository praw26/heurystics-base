---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('case-studies')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---
<Layout title="Work — Heurystics" current="work">
  <section class="page-head wrap" style="border-top:none;">
    <div class="section-label">// work</div>
    <h1 class="page-title">Case studies.</h1>
    <p class="lead">Every project, documented — what got built, how, and whether it actually worked.</p>
  </section>

  <section style="border-top:none; padding-top:0;">
    <div class="wrap">
      <div class="case-list">
        {caseStudies.map((cs) => (
          <a href={`/work/${cs.slug}`} class="case-row">
            <div class="case-row-top">
              <span class="status-pill"><span class="dot"></span>{cs.data.statusLabel}</span>
            </div>
            <h2>{cs.data.title}</h2>
            <p>{cs.data.summary}</p>
            <div class="tags">
              {cs.data.tags?.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head { padding: 64px 0 40px; }
  h1.page-title { font-family: var(--display); font-weight: 600; font-size: clamp(30px, 5vw, 44px); max-width: 16ch; margin: 0 0 18px; }
  p.lead { color: var(--text-muted); font-size: 18px; max-width: 54ch; margin: 0; }

  .case-list { display: flex; flex-direction: column; gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
  .case-row { display: block; background: var(--panel); padding: 28px 30px; text-decoration: none; transition: background .15s ease; }
  .case-row:hover { background: var(--panel-2); }
  .case-row-top { margin-bottom: 14px; }
  .status-pill { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 12px; color: var(--accent); border: 1px solid var(--accent-dim); border-radius: 20px; padding: 5px 12px; }
  .status-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .case-row h2 { font-family: var(--display); font-size: 20px; font-weight: 600; margin: 0 0 10px; color: var(--text); }
  .case-row p { color: var(--text-muted); font-size: 15px; margin: 0 0 16px; max-width: 62ch; }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; }
  .tag { font-family: var(--mono); font-size: 11px; color: var(--text-dim); border: 1px solid var(--border); border-radius: 3px; padding: 3px 9px; }
</style>
