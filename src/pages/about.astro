---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About — Heurystics" current="about">
  <section class="page-head wrap about-hero" style="border-top:none;">
    <img src="/images/deer.png" alt="" aria-hidden="true" class="about-deer" width="160" height="229" loading="lazy" />
    <img src="/images/pallav.jpg" alt="Pallav Rawat" class="about-photo" width="120" height="120" loading="eager" />
    <div>
      <div class="section-label">// about</div>
      <h1 class="page-title">A one-person consultancy, in practice.</h1>
      <p class="lead">Heurystics is Pallav — this is a personal playground as much as a practice. Every use case, working or not, gets written up in public.</p>
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <h2 class="h">What I do</h2>
      <p class="body">I help businesses find real use cases and put AI to work — identifying the boring, manual, repetitive stuff in a workflow, then building small AI tools and connectors that save time and improve efficiency.</p>
      <p class="body">I'm currently also open to contract engagements: AI requirements engineering, AI product management, AI forward deployed engineering, data analysis, and business analysis.</p>
      <p class="body aside">Yes, I wrote the copy on this page myself. No agency, no ghostwriter — same rule as everything else here.</p>
    </div>
  </section>

  <section>
    <div class="wrap narrow">
      <h2 class="h">Background</h2>
      <div class="timeline">
        <div class="t-row">
          <div class="when">SEP 2026 —<br>PRESENT</div>
          <div><div class="role">Co-Owner, Silk Route AB</div><div class="desc">Automated operations, minimum daily involvement.</div></div>
        </div>
        <div class="t-row">
          <div class="when">AUG 2026 —<br>PRESENT</div>
          <div><div class="role">Consultant, Heurystics</div><div class="desc">AI deployment consulting — use-case discovery, small AI tools, and connectors for real businesses.</div></div>
        </div>
        <div class="t-row">
          <div class="when">DEC 2024 —<br>AUG 2026</div>
          <div><div class="role">Chief Executive Officer, Silk Route AB</div><div class="desc">Co-founded Scandinavia's first premium instant chai brand — built end-to-end across D2C, Amazon, and retail across Europe.</div></div>
        </div>
        <div class="t-row">
          <div class="when">8+ YEARS<br>PRIOR</div>
          <div><div class="role">Data, tech & analytics</div><div class="desc">Across data strategy, solution development, electrification, and autonomous systems.</div></div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-head { padding: 64px 0 8px; }
  .about-hero { display: flex; gap: 28px; align-items: flex-start; position: relative; }
  .about-photo { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; flex-shrink: 0; border: 3px solid var(--panel); box-shadow: 0 6px 18px rgba(22,21,15,0.12); transform: rotate(-3deg); }
  .about-deer { position: absolute; top: -28px; right: -4px; width: 110px; height: auto; transform: rotate(6deg); opacity: 0.9; pointer-events: none; }
  @media (max-width: 900px) { .about-deer { display: none; } }
  h1.page-title { font-family: var(--display); font-weight: 600; font-size: clamp(30px, 5vw, 44px); max-width: 16ch; margin: 0 0 22px; }
  p.lead { color: var(--text-muted); font-size: 18px; max-width: 54ch; margin: 0; }
  h2.h { font-family: var(--display); font-weight: 600; font-size: 20px; margin: 0 0 14px; }
  p.body { color: var(--text-muted); font-size: 16px; margin: 0 0 14px; }
  p.body.aside { font-family: var(--mono); font-size: 13px; color: var(--text-dim); }

  @media (max-width: 560px) {
    .about-hero { flex-direction: column; align-items: flex-start; }
  }

  .timeline { margin-top: 8px; }
  .t-row { display: grid; grid-template-columns: 130px 1fr; gap: 18px; padding: 18px 0; border-top: 1px solid var(--border); }
  .t-row:first-child { border-top: none; }
  .t-row .when { font-family: var(--mono); font-size: 12.5px; color: var(--text-dim); padding-top: 2px; }
  .t-row .role { font-family: var(--display); font-size: 15.5px; font-weight: 600; margin-bottom: 5px; }
  .t-row .desc { color: var(--text-muted); font-size: 14.5px; }
</style>
