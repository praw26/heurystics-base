---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';

const packages = [
  {
    num: '01',
    name: 'Operations on Autopilot',
    headline: 'Your managing broker gets 15 hours back. Every week.',
    problem: 'Managing brokers at growing firms spend their days repeating the same answers, chasing agents for missing documents, and unblocking bottlenecks that should never have existed. The bigger the team, the more time leadership spends on operations instead of growth.',
    outcome: 'Your team gets instant answers to policy questions. Missing documents get chased automatically. Leadership gets a daily summary of what needs attention — ranked by how much money is at stake. The managing broker stops being the bottleneck and starts being the strategist.',
    results: [
      { stat: '15 hrs/week', label: 'reclaimed for leadership' },
      { stat: '100%', label: 'compliance on document filing' },
      { stat: '90 days', label: 'pilot to prove it works' },
    ],
    pilot: '$0 setup for founding partners. $299/month.',
    ideal: 'Broker-owners and COOs at 50-200 person firms who are tired of being the answer desk.',
  },
  {
    num: '02',
    name: 'Never Miss a Lead Again',
    headline: 'Every inquiry answered in under 60 seconds. Nights, weekends, holidays.',
    problem: 'Mid-sized firms lose 25% of inbound interest because agents are in the field and nobody picks up after 5 PM. High-intent prospects want answers now. By tomorrow morning, they have called your competitor.',
    outcome: 'Every prospect gets an immediate, knowledgeable response — not a voicemail, not a chatbot that says "someone will get back to you." It checks current listings, answers specific property questions, and books tours directly onto your agents\' calendars. Your firm never goes dark.',
    results: [
      { stat: '40%', label: 'more after-hours tour bookings' },
      { stat: '0%', label: 'lead drop-off rate' },
      { stat: '<60s', label: 'average response time' },
    ],
    pilot: '$0 setup + first month free for founding partners. $349/month.',
    ideal: 'Brokerages and teams losing deals because speed-to-lead drops after business hours.',
  },
  {
    num: '03',
    name: 'Deals That Close Themselves',
    headline: 'See which deals are healthy, which are stalling, and why — without asking anyone.',
    problem: 'In a growing brokerage, the pipeline is a black box. Managing brokers can\'t see why deals are stalling without manual audits. Missing paperwork kills deals at the 11th hour. Status update meetings waste everyone\'s time.',
    outcome: 'Every active deal gets a live health score. When a document is uploaded, the deal stage advances automatically. Missing signatures get flagged before they become emergencies. The escrow officer gets pinged before you have to think about it. Your weekly status meetings become unnecessary.',
    results: [
      { stat: '15%', label: 'faster time to close' },
      { stat: '0', label: 'manual status-reporting meetings' },
      { stat: '$10K-50K', label: 'saved per deal that would have collapsed' },
    ],
    pilot: '$0 setup. Only pay if it clears 5 deals. $299/month.',
    ideal: 'Brokerages running 20+ concurrent deals where pipeline visibility is a constant problem.',
  },
  {
    num: '04',
    name: 'Your Firm\'s Memory',
    headline: 'Ask any question about any deal, any document, any time.',
    problem: 'Your firm has years of valuable data — past deals, inspection reports, neighborhood trends, playbooks — trapped in PDFs, old emails, and shared drives that nobody has time to search. New hires take months to get up to speed. Institutional knowledge walks out the door when people leave.',
    outcome: 'Your team asks a question in plain English and gets an answer in seconds. "Find me every house we sold in the last 2 years with foundation issues." "Summarize the feedback from all Q1 inspections." Every document your firm has ever created becomes searchable, retrievable, and useful — instead of buried.',
    results: [
      { stat: '4 hrs/week', label: 'saved per user in search time' },
      { stat: 'Day 1', label: 'new hires productive immediately' },
      { stat: '0', label: 'institutional knowledge lost' },
    ],
    pilot: '$0 setup for founding partners. $399/month.',
    ideal: 'Firms with 5+ years of accumulated documents and knowledge that nobody can find.',
  },
];
---

<BaseLayout
  title="Services for Brokerages — Heurystics"
  description="Four ways Heurystics helps real estate brokerages run better operations. Fewer missed deadlines, faster closings, no lost leads, instant answers."
>

  <!-- Hero -->
  <section class="section">
    <div class="container" style="max-width: 800px;">
      <p class="eyebrow fade-up">For brokerages</p>
      <h1 class="fade-up delay-1">We don't sell you software. We take over the work.</h1>
      <p class="lead fade-up delay-2" style="margin-top: 16px;">
        Most firms buy tools and then spend months figuring out how to use them.
        We do it differently. We look at what's costing you time and money,
        we set up the operations that handle it, and you see results in weeks — not quarters.
        If it doesn't work, you stop paying. That simple.
      </p>
    </div>
  </section>

  <!-- How it works strip -->
  <section class="section section-limestone" style="padding: 48px 0;">
    <div class="container">
      <div class="how-strip">
        <div class="how-step fade-up">
          <span class="how-num mono">01</span>
          <span class="how-label">We map your bottlenecks</span>
          <span class="how-desc">30 minutes. You walk away knowing exactly where time and money are leaking.</span>
        </div>
        <div class="how-arrow">&rarr;</div>
        <div class="how-step fade-up delay-1">
          <span class="how-num mono">02</span>
          <span class="how-label">We run a 90-day pilot</span>
          <span class="how-desc">One specific problem. Measurable outcome. No long-term commitment.</span>
        </div>
        <div class="how-arrow">&rarr;</div>
        <div class="how-step fade-up delay-2">
          <span class="how-num mono">03</span>
          <span class="how-label">You see the results</span>
          <span class="how-desc">Hours recovered, deals saved, leads captured. Numbers you can verify yourself.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Packages -->
  {packages.map((pkg, i) => (
    <section class={`section ${i % 2 === 1 ? 'section-alt' : ''}`}>
      <div class="container pkg-grid">
        <div class="pkg-header fade-up">
          <span class="pkg-num mono">{pkg.num}</span>
          <h2 class="pkg-name">{pkg.name}</h2>
        </div>

        <div class="pkg-content">
          <h3 class="pkg-headline fade-up">{pkg.headline}</h3>

          <div class="pkg-two-col fade-up delay-1">
            <div class="pkg-col">
              <h4 class="pkg-section-label">The problem</h4>
              <p>{pkg.problem}</p>
            </div>
            <div class="pkg-col">
              <h4 class="pkg-section-label">What changes</h4>
              <p>{pkg.outcome}</p>
            </div>
          </div>

          <div class="pkg-results fade-up delay-2">
            {pkg.results.map((r) => (
              <div class="pkg-result">
                <span class="pkg-result-stat stat-number">{r.stat}</span>
                <span class="pkg-result-label">{r.label}</span>
              </div>
            ))}
          </div>

          <div class="pkg-footer fade-up delay-3">
            <div class="pkg-pilot">
              <span class="pkg-pilot-label">Founding partner pilot</span>
              <span class="pkg-pilot-price">{pkg.pilot}</span>
            </div>
            <p class="pkg-ideal"><strong>Best fit:</strong> {pkg.ideal}</p>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- Bottom note -->
  <section class="section" style="padding: 48px 0;">
    <div class="container" style="max-width: 640px; text-align: center;">
      <p class="lead fade-up" style="font-style: italic; color: var(--sandstone);">
        We run these same systems for our own operations. Every tool we offer a client,
        we use ourselves first. Our internal operations are our best demo, our best proof,
        and our best source of honest feedback.
      </p>
    </div>
  </section>

  <CTABlock />

</BaseLayout>

<style is:global>
  .section-alt {
    background: var(--parchment);
  }

  /* How strip */
  .how-strip {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 24px;
  }

  .how-step {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 240px;
    text-align: center;
  }

  .how-num {
    font-size: 20px;
    color: var(--ochre);
    font-weight: 500;
  }

  .how-label {
    font-family: var(--font-display);
    font-size: 17px;
    color: var(--navy);
  }

  .how-desc {
    font-size: 13px;
    color: var(--driftwood);
    line-height: 1.5;
  }

  .how-arrow {
    font-size: 20px;
    color: var(--sandstone);
    margin-top: 12px;
  }

  /* Package grid */
  .pkg-grid {
    max-width: 900px;
  }

  .pkg-header {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 24px;
  }

  .pkg-num {
    font-size: 32px;
    color: var(--sandstone);
  }

  .pkg-name {
    font-size: 32px;
  }

  .pkg-headline {
    font-size: 24px;
    line-height: 1.3;
    margin-bottom: 32px;
  }

  .pkg-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-bottom: 32px;
  }

  .pkg-section-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--ochre);
    margin-bottom: 8px;
  }

  .pkg-col p {
    font-size: 14px;
    color: var(--driftwood);
    line-height: 1.7;
  }

  /* Results */
  .pkg-results {
    display: flex;
    gap: 32px;
    padding: 24px 0;
    border-top: 1px solid var(--limestone);
    border-bottom: 1px solid var(--limestone);
    margin-bottom: 24px;
  }

  .pkg-result {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pkg-result-stat {
    font-size: 22px;
    color: var(--ochre);
  }

  .pkg-result-label {
    font-size: 12px;
    color: var(--driftwood);
  }

  /* Footer */
  .pkg-pilot {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .pkg-pilot-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--sandstone);
  }

  .pkg-pilot-price {
    font-size: 14px;
    font-weight: 600;
    color: var(--navy);
  }

  .pkg-ideal {
    font-size: 13px;
    color: var(--sandstone);
  }

  .pkg-ideal strong {
    color: var(--driftwood);
  }

  @media (max-width: 768px) {
    .how-strip {
      flex-direction: column;
      align-items: center;
    }
    .how-arrow {
      transform: rotate(90deg);
      margin: 0;
    }
    .pkg-two-col {
      grid-template-columns: 1fr;
    }
    .pkg-results {
      flex-direction: column;
      gap: 16px;
    }
    .pkg-header {
      flex-direction: column;
      gap: 4px;
    }
    .pkg-name {
      font-size: 26px;
    }
  }
</style>
