---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';
import SlackChat from '../components/SlackChat.tsx';
import '../styles/slack.css';
---

<BaseLayout
  title="Heurystics — AI That Runs Your Brokerage Operations"
  description="Heurystics sets up AI that handles brokerage operations — document chasing, commission errors, missed leads, deal tracking. Your team focuses on closing deals. Results in weeks."
>

  <!-- ===== 1. HERO: Problem + Identity ===== -->
  <section class="section hero-section">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow fade-up">For real estate brokerages</p>
        <h1 class="fade-up delay-1">
          Your team is spending 60% of their time on work that should <em class="hero-em">run itself.</em>
        </h1>
        <p class="lead hero-body fade-up delay-2">
          Document chasing. Commission errors. Missed leads after 5 PM.
          Deals stalling because nobody can see the pipeline.
          Heurystics sets up AI that handles these operations for you —
          around the clock, in the tools your team already uses.
        </p>
        <div class="hero-buttons fade-up delay-3">
          <a href="#book" class="btn btn-navy">Book a free assessment</a>
          <a href="#proof" class="btn btn-outline">See the results &darr;</a>
        </div>
      </div>
      <div class="hero-visual fade-up delay-4">
        <SlackChat client:visible />
        <p class="slack-caption">What your team sees: AI coordinating a live deal across deadlines, documents, and people — without anyone asking it to.</p>
      </div>
    </div>
  </section>

  <!-- ===== 2. PROOF: Social proof near the top (CRO principle) ===== -->
  <section class="section" id="proof">
    <div class="container">
      <p class="eyebrow fade-up">We've already done this</p>
      <h2 class="fade-up delay-1">A 100+ agent brokerage. 60% cost reduction. $200K+ recovered.</h2>

      <div class="proof-single fade-up delay-2">
        <div class="proof-single-stats">
          <div class="proof-single-stat">
            <span class="proof-stat stat-number">60%</span>
            <span class="proof-stat-label">reduction in operational costs</span>
          </div>
          <div class="proof-single-stat">
            <span class="proof-stat stat-number">$200K+</span>
            <span class="proof-stat-label">annual revenue recovered</span>
          </div>
          <div class="proof-single-stat">
            <span class="proof-stat stat-number">6 weeks</span>
            <span class="proof-stat-label">from start to full deployment</span>
          </div>
          <div class="proof-single-stat">
            <span class="proof-stat stat-number">3-5x</span>
            <span class="proof-stat-label">ROI in the first year</span>
          </div>
        </div>
        <p class="proof-single-body">
          A growing brokerage in California — 100+ agents, multiple offices, 200-unit property management portfolio.
          Commission errors went from 2-5% of revenue to near zero. Deal tracking went from 20-25 hours a week
          of manual work to fully automated. Listing launches went from 8-10 hours each to minutes.
        </p>
        <a href="/work" class="btn btn-outline" style="margin-top: 16px;">Read the full case studies &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ===== 3. OUTCOMES: What specifically changes ===== -->
  <section class="section" id="what-changes">
    <div class="container">
      <p class="eyebrow fade-up">What changes for you</p>
      <h2 class="fade-up delay-1">Four things that stop being your problem.</h2>

      <div class="outcome-cards">
        <!-- Card 1 -->
        <div class="outcome-card card fade-up">
          <div class="outcome-visual navy-bg">
            <div class="oc-icon-group">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="oc-icon"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="10"/></svg>
              <span class="oc-stat-big">15 hrs</span>
              <span class="oc-stat-sub">reclaimed weekly</span>
            </div>
          </div>
          <div class="outcome-content">
            <span class="outcome-label">Operations on Autopilot</span>
            <h4><em>Your managing broker gets 15 hours back. Every week.</em></h4>
            <p>Staff gets instant answers to policy questions. Missing documents get chased automatically. Leadership gets a daily friction report — what needs attention, ranked by how much money is at stake.</p>
            <div class="outcome-tags">
              <span class="tag">15 hrs/week reclaimed</span>
              <span class="tag">100% document compliance</span>
            </div>
            <span class="deploy-time">Results in 2–4 weeks</span>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="outcome-card card fade-up delay-1">
          <div class="outcome-visual navy-bg">
            <div class="oc-icon-group">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="oc-icon"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              <span class="oc-stat-big">&lt;60s</span>
              <span class="oc-stat-sub">every inquiry answered</span>
            </div>
          </div>
          <div class="outcome-content">
            <span class="outcome-label">Never Miss a Lead Again</span>
            <h4><em>Every inquiry answered in under 60 seconds. Nights, weekends, holidays.</em></h4>
            <p>Prospects get immediate, knowledgeable responses — not voicemail. Listing questions answered, tour bookings made, qualified leads routed to the right agent. Your firm never goes dark.</p>
            <div class="outcome-tags">
              <span class="tag">40% more after-hours bookings</span>
              <span class="tag">0% lead drop-off</span>
            </div>
            <span class="deploy-time">Results in 2 weeks</span>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="outcome-card card fade-up">
          <div class="outcome-visual navy-bg">
            <div class="oc-icon-group">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="oc-icon"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              <span class="oc-stat-big">15%</span>
              <span class="oc-stat-sub">faster time to close</span>
            </div>
          </div>
          <div class="outcome-content">
            <span class="outcome-label">Deals That Close Themselves</span>
            <h4><em>See which deals are healthy, which are stalling, and why — without asking anyone.</em></h4>
            <p>Every active deal gets a live health score. Missing signatures flagged before they become emergencies. Escrow officers pinged before you think about it. Weekly status meetings become unnecessary.</p>
            <div class="outcome-tags">
              <span class="tag">15% faster close</span>
              <span class="tag">$10K–50K saved per rescued deal</span>
            </div>
            <span class="deploy-time">Results in 2–3 weeks</span>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="outcome-card card fade-up delay-1">
          <div class="outcome-visual navy-bg">
            <div class="oc-icon-group">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="oc-icon"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <span class="oc-stat-big">4 hrs</span>
              <span class="oc-stat-sub">saved per user per week</span>
            </div>
          </div>
          <div class="outcome-content">
            <span class="outcome-label">Your Firm's Memory</span>
            <h4><em>Ask any question about any deal, any document, any time.</em></h4>
            <p>Years of past deals, inspection reports, and playbooks — searchable in plain English. New hires productive on day one. Institutional knowledge stops walking out the door when people leave.</p>
            <div class="outcome-tags">
              <span class="tag">Day 1 onboarding</span>
              <span class="tag">Zero knowledge lost</span>
            </div>
            <span class="deploy-time">Results in 2 weeks</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 4. HOW + DIFFERENTIATION: Mechanism + objection handling ===== -->
  <section class="section how-section" id="how-it-works">
    <div class="container how-container">
      <p class="eyebrow fade-up">How it actually works</p>
      <h2 class="fade-up delay-1">We set up AI that runs your operations. 24/7.</h2>
      <p class="lead how-lead fade-up delay-2">
        Not a chatbot. Not a dashboard you have to check. Not another tool your team has to learn.
      </p>

      <div class="how-steps-grid fade-up delay-3">
        <div class="how-step-card">
          <span class="how-step-num mono">01</span>
          <h4>We study how your firm actually works</h4>
          <p>Your deal flow, your document processes, your commission structures, your pain points. We map the workflows that are eating your time.</p>
        </div>
        <div class="how-step-card">
          <span class="how-step-num mono">02</span>
          <h4>We build AI that handles it</h4>
          <p>Purpose-built for your operation. It chases documents, catches errors, answers inquiries, tracks deals — autonomously, around the clock.</p>
        </div>
        <div class="how-step-card">
          <span class="how-step-num mono">03</span>
          <h4>Your team sees the results</h4>
          <p>In Slack, email, your CRM — whatever you already use. Nothing changes for them except the work gets done. No new software to learn.</p>
        </div>
      </div>

      <div class="how-not fade-up">
        <h4 class="how-not-heading">How this is different from what you've tried</h4>
        <div class="how-not-grid-3">
          <div class="how-not-item">
            <span class="how-not-label mono">Hiring another TC</span>
            <p>$50K–70K/year. 40 hours a week. Months to train. One thing at a time. Calls in sick.</p>
          </div>
          <div class="how-not-item">
            <span class="how-not-label mono">Adding AI features to your CRM</span>
            <p>Lofty, Rechat, kvCORE add features you still have to use. They help you work. They don't do the work.</p>
          </div>
          <div class="how-not-item">
            <span class="how-not-label mono" style="color: var(--ochre)">Heurystics</span>
            <p>Takes over the workflow entirely. Works 24/7. Handles 40+ deals simultaneously. You see results, not another dashboard.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 5. COST OF INACTION: What it's costing you to wait ===== -->
  <section class="section stat-section">
    <div class="container stat-center fade-up">
      <span class="stat-big">$250K</span>
      <p class="stat-desc">leaked annually in commission errors by the average 100-agent brokerage.</p>
      <p class="stat-sub mono">2–5% of gross revenue. Every month you wait, more money disappears.</p>
    </div>
  </section>

  <!-- ===== 6. CTA ===== -->
  <CTABlock />

</BaseLayout>

<style is:global>
  /* Hero */
  .hero-section { padding-top: 72px; padding-bottom: 72px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .hero-em { color: var(--ochre); font-style: italic; }
  .hero-body { margin-top: 20px; }
  .hero-buttons { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .slack-caption { font-size: 12px; color: var(--sandstone); text-align: center; margin-top: 12px; font-style: italic; }

  /* Proof */
  .proof-single { margin-top: 40px; padding: 40px; background: var(--navy); border-radius: 3px; }
  .proof-single-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 28px; padding-bottom: 28px; border-bottom: 1px solid rgba(255,255,255,0.08); }
  .proof-single-stat { display: flex; flex-direction: column; gap: 4px; }
  .proof-stat { font-size: 32px; color: var(--ochre); }
  .proof-stat-label { font-size: 12px; color: rgba(255,255,255,0.45); line-height: 1.4; }
  .proof-single-body { font-size: 15px; color: rgba(255,255,255,0.6); line-height: 1.7; max-width: 640px; }

  /* Outcome cards */
  .outcome-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 48px; }
  .outcome-card { display: flex; flex-direction: column; overflow: hidden; }
  .outcome-visual { padding: 28px 20px; min-height: 140px; display: flex; align-items: center; justify-content: center; }
  .navy-bg { background: var(--navy); }
  .oc-icon-group { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .oc-icon { width: 32px; height: 32px; color: var(--ochre); }
  .oc-stat-big { font-family: var(--font-mono); font-size: 28px; font-weight: 500; color: #fff; }
  .oc-stat-sub { font-family: var(--font-mono); font-size: 11px; color: rgba(255,255,255,0.45); }
  .outcome-content { padding: 24px; flex: 1; display: flex; flex-direction: column; gap: 10px; }
  .outcome-label { font-family: var(--font-mono); font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: 1.5px; color: var(--ochre); }
  .outcome-content h4 { font-size: 17px; line-height: 1.35; }
  .outcome-content p { font-size: 14px; color: var(--driftwood); line-height: 1.65; }
  .outcome-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; }

  /* How it works */
  .how-section { background: var(--parchment); }
  .how-container { max-width: 900px; }
  .how-lead { max-width: 540px; margin-bottom: 48px; }
  .how-steps-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 48px; }
  .how-step-card { padding: 28px 24px; border-radius: 3px; border: 1px solid var(--limestone); background: var(--nordic-light); }
  .how-step-num { font-size: 20px; color: var(--ochre); display: block; margin-bottom: 12px; }
  .how-step-card h4 { font-size: 17px; margin-bottom: 8px; }
  .how-step-card p { font-size: 14px; color: var(--driftwood); line-height: 1.65; }
  .how-not { padding: 32px; border-radius: 3px; border: 1px solid var(--limestone); background: var(--nordic-light); }
  .how-not-heading { font-size: 18px; margin-bottom: 20px; }
  .how-not-label { font-size: 12px; text-transform: uppercase; letter-spacing: 1px; color: var(--sandstone); display: block; margin-bottom: 6px; }
  .how-not-item p { font-size: 14px; color: var(--driftwood); line-height: 1.65; }
  .how-not-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; }

  /* Stat */
  .stat-section { padding: 80px 0; }
  .stat-center { text-align: center; }
  .stat-big { font-family: var(--font-display); font-size: 96px; color: var(--ochre); display: block; line-height: 1; }
  .stat-desc { font-size: 18px; color: var(--navy); margin-top: 12px; max-width: 540px; margin-inline: auto; }
  .stat-sub { font-size: 12px; color: var(--sandstone); margin-top: 8px; }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .outcome-cards { grid-template-columns: 1fr; }
    .proof-single-stats { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 768px) {
    .stat-big { font-size: 64px; }
    .hero-buttons { flex-direction: column; }
    .hero-buttons .btn { text-align: center; justify-content: center; }
    .hero-visual { order: 1; }
    .how-steps-grid { grid-template-columns: 1fr; }
    .how-not-grid-3 { grid-template-columns: 1fr; }
  }
</style>
