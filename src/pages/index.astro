---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';
import SlackChat from '../components/SlackChat.tsx';
import '../styles/slack.css';
---

<BaseLayout
  title="Heurystics — AI That Runs Your Real Estate Operations"
  description="Heurystics automates the repetitive operations holding your real estate business back. Document chasing, deal tracking, after-hours inquiries, onboarding. Results in weeks."
>

  <!-- ===== 1. HERO ===== -->
  <section class="section hero-section">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="hero-who fade-up">For managing brokers, broker-owners, and operations leads</p>
        <h1 class="fade-up delay-1">
          We automate the dull parts so you can focus on the <em class="hero-em">important ones.</em>
        </h1>
        <p class="lead hero-body fade-up delay-2">
          Document chasing. Commission reconciliation. After-hours inquiries nobody answers.
          Deals stalling because nobody can see the pipeline. We come in, study how your
          operation works, and build AI systems that take over these workflows — custom to you,
          running around the clock, inside the tools your team already uses.
        </p>
        <div class="hero-buttons fade-up delay-3">
          <a href="#book" class="btn btn-primary">Book a free assessment</a>
          <a href="/work" class="btn btn-outline">See our previous work &rarr;</a>
        </div>
        <p class="hero-friction fade-up delay-3">Free. 30 minutes. No commitment. No sales pitch.</p>
      </div>
      <div class="hero-visual fade-up delay-3">
        <SlackChat client:visible />
        <p class="slack-caption">AI coordinating a live deal — tracking deadlines, flagging overdue items, notifying the right people. No one had to ask it to.</p>
      </div>
    </div>
  </section>

  <!-- ===== LOGO STRIP ===== -->
  <div class="logo-strip">
    <div class="container logo-strip-inner">
      <div class="logo-strip-logos">
        <!-- NUG - bold caps wordmark like their actual branding -->
        <svg viewBox="0 0 72 28" class="logo-item">
          <text x="0" y="23" font-family="'DM Serif Display', Georgia, serif" font-weight="400" font-size="26" letter-spacing="3" fill="currentColor">NUG</text>
        </svg>
        <!-- openigloo - lowercase like their actual brand -->
        <svg viewBox="0 0 130 28" class="logo-item">
          <text x="0" y="21" font-family="'Plus Jakarta Sans', sans-serif" font-weight="700" font-size="18" fill="currentColor">openigloo</text>
        </svg>
        <!-- Almi - clean sans like their actual logo -->
        <svg viewBox="0 0 70 28" class="logo-item">
          <text x="0" y="22" font-family="'Plus Jakarta Sans', sans-serif" font-weight="700" font-size="24" fill="currentColor">Almi</text>
        </svg>
        <!-- Stockholm University / Business School -->
        <svg viewBox="0 0 110 30" class="logo-item sbs-logo">
          <text x="0" y="13" font-family="'Plus Jakarta Sans', sans-serif" font-weight="700" font-size="11" letter-spacing="1.5" fill="currentColor">STOCKHOLM</text>
          <text x="0" y="27" font-family="'Plus Jakarta Sans', sans-serif" font-weight="400" font-size="11" fill="currentColor">Business School</text>
        </svg>
      </div>
    </div>
  </div>

  <!-- ===== 2. PROOF: What our team has built ===== -->
  <section class="section" id="proof">
    <div class="container">
      <p class="eyebrow fade-up">Our previous work</p>
      <h2 class="fade-up delay-1">AI operations running in production. Today.</h2>

      <div class="proof-grid fade-up delay-2">
        <!-- Case 1: RE Brokerage -->
        <div class="proof-card-block">
          <div class="proof-card-header navy-bg">
            <span class="proof-card-label mono">Real estate brokerage &middot; 100+ agents</span>
            <svg viewBox="0 0 80 60" fill="none" class="proof-svg">
              <rect x="4" y="8" width="72" height="44" rx="2" stroke="rgba(255,255,255,0.2)" stroke-width="1"/>
              <rect x="8" y="14" width="28" height="6" rx="1" fill="#B5862A" opacity="0.7"/>
              <rect x="8" y="24" width="20" height="6" rx="1" fill="rgba(255,255,255,0.15)"/>
              <rect x="8" y="34" width="24" height="6" rx="1" fill="rgba(255,255,255,0.15)"/>
              <rect x="40" y="14" width="32" height="26" rx="1" fill="rgba(255,255,255,0.06)"/>
              <circle cx="56" cy="27" r="6" stroke="#B5862A" stroke-width="1.5" fill="none"/>
              <path d="M54 27l2 2 4-4" stroke="#4CAF50" stroke-width="1.5" fill="none"/>
            </svg>
          </div>
          <div class="proof-card-body">
            <p>Built 8 AI operations for a California brokerage — deal tracking, commission reconciliation, listing launches, compliance, lead intelligence, property management, market analysis, and business reporting.</p>
            <div class="proof-card-stats">
              <span><strong>Commission errors</strong> went to near zero</span>
              <span><strong>20-25 hrs/week</strong> of manual work eliminated</span>
              <span><strong>6 weeks</strong> to full deployment</span>
            </div>
          </div>
        </div>

        <!-- Case 2: Pharmacy chain -->
        <div class="proof-card-block">
          <div class="proof-card-header navy-bg">
            <span class="proof-card-label mono">Multi-location retail &middot; 5+ stores</span>
            <svg viewBox="0 0 80 60" fill="none" class="proof-svg">
              <rect x="4" y="40" width="14" height="12" rx="1" fill="rgba(255,255,255,0.12)"/>
              <rect x="22" y="34" width="14" height="18" rx="1" fill="rgba(255,255,255,0.18)"/>
              <rect x="40" y="28" width="14" height="24" rx="1" fill="rgba(255,255,255,0.24)"/>
              <rect x="58" y="22" width="14" height="30" rx="1" fill="#B5862A" opacity="0.6"/>
              <path d="M11 38 L29 32 L47 26 L65 20" stroke="#B5862A" stroke-width="1" stroke-dasharray="3 2" fill="none"/>
            </svg>
          </div>
          <div class="proof-card-body">
            <p>Built the full operations platform for a pharmacy chain — POS, inventory, vendor management, marketing campaigns, demand forecasting — then deployed 8 AI operations on top that run the business.</p>
            <div class="proof-card-stats">
              <span><strong>8 AI operations</strong> running 24/7</span>
              <span><strong>5+ locations</strong> on one system</span>
              <span><strong>12 weeks</strong> to full deployment</span>
            </div>
          </div>
        </div>
      </div>

      <div class="proof-note fade-up">
        <a href="/work" class="btn btn-navy" style="margin-top: 8px;">Read the full case studies &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ===== 3. WHAT CHANGES: Concrete, relatable examples ===== -->
  <section class="section" id="what-changes">
    <div class="container">
      <p class="eyebrow fade-up">What changes for you</p>
      <h2 class="fade-up delay-1">Real examples of what starts running itself.</h2>

      <div class="use-case-cards">
        <div class="use-case-card card fade-up">
          <div class="uc-top">
            <img src="/images/uc-documents.png" alt="AI notification: Title search overdue, escalated automatically" class="uc-img" />
          </div>
          <div class="uc-body">
            <h4>Manage documents from your team chat</h4>
            <p>Missing signatures, incomplete disclosures, overdue title searches — flagged and chased automatically inside Slack or Teams. Your team never opens a spreadsheet to track a file again.</p>
            <span class="deploy-time">Live in 2–3 weeks</span>
          </div>
        </div>

        <div class="use-case-card card fade-up delay-1">
          <div class="uc-top">
            <img src="/images/uc-leads.png" alt="AI responding to a prospect inquiry at 9:47 PM" class="uc-img" />
          </div>
          <div class="uc-body">
            <h4>Answer after-hours inquiries about specific deals</h4>
            <p>A prospect asks about 742 Elm St at 9 PM. They get an immediate, knowledgeable response — not voicemail. Tours booked, questions answered, leads routed. Your firm never goes dark.</p>
            <span class="deploy-time">Live in 2 weeks</span>
          </div>
        </div>

        <div class="use-case-card card fade-up delay-2">
          <div class="uc-top">
            <img src="/images/uc-pipeline.png" alt="Deal pipeline dashboard with health scores" class="uc-img" />
          </div>
          <div class="uc-body">
            <h4>Always know what stage every deal is at</h4>
            <p>Every active deal gets a live health score. You see which ones are on track, which are stalling, and why — without asking anyone. Status meetings become unnecessary.</p>
            <span class="deploy-time">Live in 2–3 weeks</span>
          </div>
        </div>

        <div class="use-case-card card fade-up delay-3">
          <div class="uc-top">
            <img src="/images/uc-search.png" alt="Search interface: foundation issues last 2 years" class="uc-img" />
          </div>
          <div class="uc-body">
            <h4>Search every deal, document, and note instantly</h4>
            <p>Years of past deals, inspection reports, and playbooks — searchable in plain English. New hires productive on day one. Institutional knowledge stops walking out the door.</p>
            <span class="deploy-time">Live in 2 weeks</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 4. HOW IT WORKS: Explore → Pilot → Results → Retain ===== -->
  <section class="section how-section" id="how-it-works">
    <div class="container how-container">
      <p class="eyebrow fade-up">How we work</p>
      <h2 class="fade-up delay-1">We simplify your pain points.</h2>
      <p class="lead how-lead fade-up delay-2">
        Not a chatbot. Not a dashboard. Not another tool your team has to learn.
      </p>

      <div class="how-steps-grid fade-up delay-3">
        <div class="how-step-card">
          <span class="how-step-num mono">01</span>
          <span class="how-step-label">Explore</span>
          <p>We map your workflows and find where time and money are leaking. Free. 30 minutes. You keep the findings whether you hire us or not.</p>
        </div>
        <div class="how-step-card">
          <span class="how-step-num mono">02</span>
          <span class="how-step-label">Pilot</span>
          <p>We pick the highest-impact problem and build AI that handles it. Real data, real workflows. You see results in 2–4 weeks.</p>
        </div>
        <div class="how-step-card">
          <span class="how-step-num mono">03</span>
          <span class="how-step-label">Results</span>
          <p>You measure the outcomes yourself. Hours saved, errors caught, deals rescued. The numbers speak. No lock-in.</p>
        </div>
        <div class="how-step-card">
          <span class="how-step-num mono">04</span>
          <span class="how-step-label">Retain</span>
          <p>Working? We stay and add the next workflow. Not working? You stop. No lock-in, just outcomes that compound.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 5. CTA (straight after pipeline, no $250K stat) ===== -->
  <CTABlock />

</BaseLayout>

<!-- Styles in global.css to avoid Tailwind 4 layer conflicts -->
