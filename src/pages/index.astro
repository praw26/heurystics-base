---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';
import SlackChat from '../components/SlackChat.tsx';
import '../styles/slack.css';

const caseStudies = (await getCollection('case-studies')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const featured = caseStudies[0];
---

<BaseLayout
  title="Heurystics — AI Deployment, Now and For Real"
  description="I find the boring, manual, repetitive stuff in a business's workflow and build small AI tools and connectors that save time. Every project becomes a public case study."
>

  <!-- ===== 1. HERO ===== -->
  <section class="section hero-section">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="hero-who fade-up">AI deployment, now and for real</p>
        <h1 class="fade-up delay-1">
          I find the use case, then <em class="hero-em">deploy AI</em> that actually runs it.
        </h1>
        <p class="lead hero-body fade-up delay-2">
          Heurystics is my playground for putting AI to real, practical use inside businesses.
          I look for the boring, manual, repetitive stuff in a workflow, then build small AI
          tools and connectors that save time — inside the tools you already use, not another
          dashboard to check.
        </p>
        <div class="hero-buttons fade-up delay-3">
          <a href="/work" class="btn btn-primary">See the work &rarr;</a>
          <a href="#book" class="btn btn-outline open-modal">Got a process worth automating? &rarr;</a>
        </div>
        <p class="hero-friction fade-up delay-3">Every project becomes a public case study — what got built, how, and whether it actually worked.</p>
      </div>
      <div class="hero-visual fade-up delay-3">
        <SlackChat client:visible />
        <p class="slack-caption">A real agent I built for my own company, controlled entirely from Telegram. Full write-up in the work section.</p>
      </div>
    </div>
  </section>

  <!-- ===== 2. WHAT I DO ===== -->
  <section class="section" id="what-i-do">
    <div class="container">
      <p class="eyebrow fade-up">What I do</p>
      <h2 class="fade-up delay-1">Not an industry. A pattern I look for anywhere.</h2>

      <div class="use-case-cards">
        <div class="use-case-card card fade-up">
          <div class="uc-top navy-bg">
            <div class="uc-stat-group">
              <span class="uc-stat-number">01</span>
              <span class="uc-stat-desc">Find the use case</span>
            </div>
          </div>
          <div class="uc-body">
            <h4>Watch how you actually work</h4>
            <p>Not a workshop, not a survey. I sit with how a team actually operates and find the specific task that's boring, repetitive, and worth automating — and I'll say so if there isn't one yet.</p>
          </div>
        </div>

        <div class="use-case-card card fade-up delay-1">
          <div class="uc-top navy-bg">
            <div class="uc-stat-group">
              <span class="uc-stat-number">02</span>
              <span class="uc-stat-desc">Build the tool</span>
            </div>
          </div>
          <div class="uc-body">
            <h4>Wire it into what you already use</h4>
            <p>Small, scoped AI agents and connectors — Shopify, Drive, Notion, Slack, Telegram, whatever the team lives in. No new tool for people to learn.</p>
          </div>
        </div>

        <div class="use-case-card card fade-up delay-2">
          <div class="uc-top navy-bg">
            <div class="uc-stat-group">
              <span class="uc-stat-number">03</span>
              <span class="uc-stat-desc">Prove it works</span>
            </div>
          </div>
          <div class="uc-body">
            <h4>Publish what actually happened</h4>
            <p>What got built, how, and whether it held up in real use — including what didn't work. Getting an agent connected is the easy 20%. Making it reliable is the hard 80%, and that's the part I document.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 3. FEATURED CASE STUDY ===== -->
  {featured && (
    <section class="section section-limestone" id="featured-work">
      <div class="container">
        <p class="eyebrow fade-up">Latest work</p>
        <h2 class="fade-up delay-1">{featured.data.title}</h2>
        <p class="lead fade-up delay-2" style="max-width: 640px; margin-top: 12px;">{featured.data.summary}</p>
        <div class="work-card-tags fade-up delay-3" style="margin-top: 20px;">
          {featured.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <a href={`/work/${featured.slug}`} class="btn btn-navy fade-up delay-3" style="margin-top: 28px;">Read the full case study &rarr;</a>
      </div>
    </section>
  )}

  <!-- ===== 4. WHERE THIS GOES ===== -->
  <section class="section" id="where-this-goes">
    <div class="container" style="max-width: 720px;">
      <p class="eyebrow fade-up">Where this goes</p>
      <h2 class="fade-up delay-1">Employment, consulting, or founding — the near-term work is the same.</h2>
      <p class="lead fade-up delay-2" style="margin-top: 16px;">
        I'm building real systems, documenting them honestly, and sharing them openly — whether
        that leads to a contract role as an AI enablement / forward-deployed engineer, ongoing
        consulting work, or something I end up building on my own. Previously 8+ years across
        data strategy, solution development, and autonomous systems, and co-founder of Silk Route,
        Scandinavia's first premium instant-chai brand. More on <a href="/about">the About page</a>.
      </p>
    </div>
  </section>

  <CTABlock />

</BaseLayout>

<!-- Styles in global.css to avoid Tailwind 4 layer conflicts -->
