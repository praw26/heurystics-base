---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('case-studies')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const featured = caseStudies[0];
---
<Layout title="Heurystics — AI Deployment, now and for real" current="home">
  <section class="hero wrap">
    <div class="status-row">
      <span class="dot"></span>
      OPERATOR STATUS: ACTIVE // STOCKHOLM, SE
    </div>
    <h1 class="hero-head">AI deployment. Now and for real.</h1>
    <p class="hero-sub">I find the boring, manual, repetitive parts of a business — and build small AI tools and connectors that actually save time. Not slideware. Deployed systems, in production, documented in the open.</p>
    <div class="hero-ctas">
      <a href="/contact" class="btn-primary">Find your first use case</a>
      <a href="/work" class="btn-ghost">See the work</a>
    </div>

    <div class="log-panel">
      <div class="log-bar">
        <span>#silk-route-ops <span class="chip">· live agent</span></span>
        <span>telegram // openclaw</span>
      </div>
      <div class="log-body">
        <div class="log-line"><span class="t">08:41</span><span class="who">agent</span><span class="msg">Morning brief: 14 orders past 24h, 6 markets. Reorder flag: 2 B2B accounts due.</span></div>
        <div class="log-line"><span class="t">08:44</span><span class="who">pallav</span><span class="msg">mark #SR-4021 fulfilled</span></div>
        <div class="log-line"><span class="t">08:44</span><span class="who">agent</span><span class="msg">Done — #SR-4021 marked fulfilled in Shopify. Production sheet row added.</span></div>
        <div class="log-line"><span class="t">08:52</span><span class="who">agent</span><span class="msg">Found vendor order confirmation in Drive — reorder due in 9 days, flagged in Notion.</span></div>
      </div>
    </div>
  </section>

  <section id="pillars">
    <div class="wrap">
      <div class="section-label">// what changes</div>
      <h2 class="section-head">Four things, not forty features.</h2>
      <p class="section-body">Everything I build reduces to one of these. No platform to learn, no dashboard nobody opens — tools that sit inside the systems you already use.</p>
      <div class="cap-grid">
        <div class="cap"><h3>Use-case discovery</h3><p>Map how a workflow actually runs today, and find the specific repetitive step worth automating first — before writing a line of code.</p></div>
        <div class="cap"><h3>Small tools & connectors</h3><p>Lightweight AI wired directly into the tools already in use — Shopify, Drive, Notion, Trello — not a new system to adopt.</p></div>
        <div class="cap"><h3>Deployed, not demoed</h3><p>A working prototype in a chat window is not the finish line. The bar is: does it run unattended, and does someone actually use it.</p></div>
        <div class="cap"><h3>Public case studies</h3><p>Every project is documented — what got built, how, what broke, and whether it worked. No black box, no vague success metrics.</p></div>
      </div>
    </div>
  </section>

  {featured && (
    <section id="case-teaser">
      <div class="wrap">
        <div class="section-label">// proof</div>
        <h2 class="section-head">First deployment: an e-commerce operations agent.</h2>
        <div class="case-card">
          <span class="case-tag">CASE STUDY</span>
          <h3>{featured.data.title}</h3>
          <p>{featured.data.summary}</p>
          <a href={`/work/${featured.slug}`} class="btn-ghost">Read the full case study</a>
        </div>
      </div>
    </section>
  )}

  <section id="contact-cta" class="cta">
    <div class="wrap">
      <div class="cta-box">
        <h2>Got a process worth automating?</h2>
        <p>30 minutes. No deck, no commitment — just a look at where the time is going and whether AI is actually the answer.</p>
        <a href="/contact" class="btn-primary">Get in touch</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  section.hero { padding: 96px 0 64px; border-top: none; }
  .status-row { display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 12.5px; color: var(--text-dim); margin-bottom: 28px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px rgba(232,163,61,0.15); }
  h1.hero-head { font-family: var(--display); font-weight: 600; font-size: clamp(34px, 6vw, 58px); line-height: 1.08; letter-spacing: -0.01em; margin: 0 0 26px; max-width: 14ch; }
  p.hero-sub { font-size: 18px; color: var(--text-muted); max-width: 46ch; margin: 0 0 36px; }
  .hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; }

  .log-panel { margin-top: 64px; background: var(--panel); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
  .log-bar { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; border-bottom: 1px solid var(--border); font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
  .log-bar .chip { color: var(--accent); font-weight: 500; }
  .log-body { padding: 18px; display: flex; flex-direction: column; gap: 14px; }
  .log-line { font-family: var(--mono); font-size: 13px; line-height: 1.6; display: flex; gap: 12px; }
  .log-line .t { color: var(--text-dim); flex-shrink: 0; }
  .log-line .who { color: var(--accent); flex-shrink: 0; }
  .log-line .msg { color: var(--text-muted); }

  .cap-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--border); border: 1px solid var(--border); margin-top: 40px; border-radius: 6px; overflow: hidden; }
  .cap { background: var(--panel); padding: 28px 26px; }
  .cap h3 { font-family: var(--display); font-size: 17px; font-weight: 600; margin: 0 0 10px; }
  .cap p { color: var(--text-muted); font-size: 14.5px; margin: 0; }
  @media (max-width: 680px) { .cap-grid { grid-template-columns: 1fr; } }

  .case-card { margin-top: 36px; border: 1px solid var(--border); border-radius: 6px; background: linear-gradient(180deg, var(--panel-2), var(--panel)); padding: 30px; }
  .case-tag { font-family: var(--mono); font-size: 11.5px; color: var(--accent); border: 1px solid var(--accent-dim); border-radius: 3px; padding: 3px 8px; display: inline-block; margin-bottom: 16px; }
  .case-card h3 { font-family: var(--display); font-size: 21px; margin: 0 0 12px; }
  .case-card p { color: var(--text-muted); font-size: 15px; max-width: 62ch; }
  .case-card .btn-ghost { margin-top: 22px; }

  section.cta { text-align: left; }
  .cta-box { border: 1px solid var(--border); border-radius: 8px; padding: 48px 36px; background: var(--panel); }
  .cta-box h2 { font-family: var(--display); font-size: clamp(24px, 3.6vw, 34px); margin: 0 0 16px; max-width: 18ch; }
  .cta-box p { color: var(--text-muted); margin: 0 0 26px; max-width: 50ch; }
</style>
