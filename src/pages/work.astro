---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABlock from '../components/CTABlock.astro';

const caseStudies = (await getCollection('case-studies')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Work — Heurystics"
  description="Case studies of real AI systems built and deployed — what got built, how, and whether it actually worked."
>

  <!-- Hero -->
  <section class="section">
    <div class="container" style="max-width: 800px;">
      <p class="eyebrow fade-up">Work</p>
      <h1 class="fade-up delay-1">Every project becomes a public case study.</h1>
      <p class="lead fade-up delay-2" style="margin-top: 16px;">
        What got built, how, and whether it actually worked — including what didn't.
        This grows as I take on more use cases, client and personal.
      </p>
    </div>
  </section>

  <!-- Case study list -->
  <section class="section" style="padding-top: 0;">
    <div class="container work-list">
      {caseStudies.map((cs) => (
        <a href={`/work/${cs.id}`} class="work-card fade-up">
          <div class="work-card-body">
            <span class="work-card-status mono">{cs.data.status.split('—')[0].trim()}</span>
            <h3>{cs.data.title}</h3>
            <p>{cs.data.summary}</p>
            <div class="work-card-tags">
              {cs.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
          <span class="work-card-arrow">&rarr;</span>
        </a>
      ))}

      <div class="work-more fade-up">
        <p>More case studies land here as they're built — client work and personal projects alike.</p>
      </div>
    </div>
  </section>

  <CTABlock />

</BaseLayout>

<style is:global>
  .work-list {
    max-width: 800px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .work-card {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 32px;
    border: 1px solid var(--limestone);
    border-radius: 3px;
    background: var(--nordic-light);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .work-card:hover {
    border-color: var(--ochre);
    transform: translateY(-2px);
  }

  .work-card-status {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--ochre);
  }

  .work-card h3 {
    margin-top: 8px;
    font-size: 22px;
  }

  .work-card p {
    margin-top: 8px;
    font-size: 14px;
    color: var(--driftwood);
    line-height: 1.7;
  }

  .work-card-tags {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .work-card-arrow {
    font-size: 20px;
    color: var(--sandstone);
    flex-shrink: 0;
  }

  .work-more {
    padding: 24px 0 0;
    text-align: center;
  }

  .work-more p {
    font-size: 13px;
    color: var(--sandstone);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .work-card {
      flex-direction: column;
    }
  }
</style>
