<section class="section section-limestone" id="book">
  <div class="container cta-block">
    <div class="cta-content">
      <h2 class="cta-heading">Got a process worth automating?</h2>
      <p class="lead cta-sub">
        Tell me what's eating your team's time. If there's a real use case in it, I'll tell you
        honestly — even if the answer is "not yet."
      </p>
    </div>

    <!-- Mobile: button that opens modal -->
    <div class="cta-mobile-btn">
      <a href="#book" class="btn btn-primary open-modal" style="width: 100%; justify-content: center;">Get in touch &rarr;</a>
    </div>

    <!-- Desktop: inline form -->
    <form class="cta-form cta-inline-form" id="assessment-form">
      <div class="form-group">
        <label for="name" class="form-label">Your name</label>
        <input type="text" id="name" name="name" required class="form-input" placeholder="Jane Smith" />
      </div>
      <div class="form-group">
        <label for="email" class="form-label">Email</label>
        <input type="email" id="email" name="email" required class="form-input" placeholder="jane@company.com" />
      </div>
      <div class="form-group">
        <label for="company" class="form-label">Company <span class="form-optional">(optional)</span></label>
        <input type="text" id="company" name="company" class="form-input" placeholder="Where you work" />
      </div>
      <div class="form-group">
        <label for="message" class="form-label">What's the repetitive task worth automating?</label>
        <textarea id="message" name="message" rows="3" class="form-input form-textarea" placeholder="e.g. We're manually reconciling orders across three tools every morning..."></textarea>
      </div>
      <button type="submit" class="btn btn-primary form-submit">Send &rarr;</button>
      <p class="form-note">Opens your email app — nothing is sent from this page.</p>
    </form>
  </div>
</section>

<!-- All CTA styles in global.css to avoid Tailwind 4 layer conflicts -->

<script>
  const form = document.getElementById('assessment-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = form.querySelector('.form-submit') as HTMLButtonElement;
    const originalText = btn.innerHTML;

    const formData = new FormData(form);
    const data = Object.fromEntries(formData) as Record<string, string>;

    const subject = `Automation inquiry from ${data.name}${data.company ? ' (' + data.company + ')' : ''}`;
    const bodyLines = [
      `Name: ${data.name}`,
      `Email: ${data.email}`,
      data.company ? `Company: ${data.company}` : null,
      data.message ? `What's the repetitive task worth automating: ${data.message}` : null,
    ].filter(Boolean);

    const mailto = `mailto:hello@heurystics.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`;
    window.location.href = mailto;

    btn.textContent = 'Opening your email app...';
    btn.disabled = true;

    setTimeout(() => {
      form.reset();
      btn.innerHTML = originalText;
      btn.disabled = false;
    }, 1500);
  });
</script>
