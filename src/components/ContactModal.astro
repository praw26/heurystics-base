<!-- Contact Modal -->
<div class="modal-overlay" id="contact-modal">
  <div class="modal-content">
    <button class="modal-close" id="modal-close" aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </button>

    <h3 class="modal-heading">Got a process worth automating?</h3>
    <p class="modal-sub">Tell me what's eating your team's time. If there's a real use case in it, I'll tell you honestly — even if the answer is "not yet."</p>

    <form class="modal-form" id="modal-assessment-form">
      <div class="form-group">
        <label for="modal-name" class="form-label">Your name</label>
        <input type="text" id="modal-name" name="name" required class="form-input" placeholder="Jane Smith" />
      </div>
      <div class="form-group">
        <label for="modal-email" class="form-label">Email</label>
        <input type="email" id="modal-email" name="email" required class="form-input" placeholder="jane@company.com" />
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="modal-company" class="form-label">Company <span class="form-optional">(optional)</span></label>
          <input type="text" id="modal-company" name="company" class="form-input" placeholder="Where you work" />
        </div>
        <div class="form-group">
          <label for="modal-role" class="form-label">Your role <span class="form-optional">(optional)</span></label>
          <input type="text" id="modal-role" name="role" class="form-input" placeholder="What you do" />
        </div>
      </div>
      <div class="form-group">
        <label for="modal-message" class="form-label">What's the repetitive task worth automating? <span class="form-optional">(optional)</span></label>
        <textarea id="modal-message" name="message" rows="2" class="form-input form-textarea" placeholder="e.g. We're manually reconciling orders across three tools every morning..."></textarea>
      </div>
      <button type="submit" class="btn btn-primary form-submit">Send &rarr;</button>
      <p class="form-note">Opens your email app — nothing is sent from this page.</p>
    </form>
  </div>
</div>

<script>
  // Open/close modal
  function openModal() {
    document.getElementById('contact-modal')?.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    document.getElementById('contact-modal')?.classList.remove('open');
    document.body.style.overflow = '';
  }

  // Close button
  document.getElementById('modal-close')?.addEventListener('click', closeModal);

  // Click overlay to close
  document.getElementById('contact-modal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) closeModal();
  });

  // ESC to close
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // All "book" links open modal
  document.querySelectorAll('a[href="#book"], .open-modal').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });
  });

  // Form submission — build a mailto: link (static hosting, no backend)
  const modalForm = document.getElementById('modal-assessment-form');
  modalForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = modalForm.querySelector('.form-submit') as HTMLButtonElement;
    const originalText = btn.innerHTML;

    const formData = new FormData(modalForm);
    const data = Object.fromEntries(formData) as Record<string, string>;

    const subject = `Assessment request from ${data.name}${data.company ? ' (' + data.company + ')' : ''}`;
    const bodyLines = [
      `Name: ${data.name}`,
      `Email: ${data.email}`,
      `Company: ${data.company}`,
      data.role ? `Role: ${data.role}` : null,
      data.message ? `Biggest operational headache: ${data.message}` : null,
    ].filter(Boolean);

    const mailto = `mailto:hello@heurystics.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`;
    window.location.href = mailto;

    btn.textContent = 'Opening your email app...';
    btn.disabled = true;

    setTimeout(() => {
      closeModal();
      modalForm.reset();
      btn.innerHTML = originalText;
      btn.disabled = false;
    }, 1500);
  });

  // Expose globally for nav button
  (window as any).openContactModal = openModal;
</script>
