---
interface Props {
  size?: 'sm' | 'md';
  light?: boolean;
}

const { size = 'md', light = false } = Astro.props;
const iconSize = size === 'sm' ? 24 : 32;
const fontSize = size === 'sm' ? '17px' : '21px';
const navyColor = light ? '#fff' : '#1B2A4A';
---

<a href="/" class="logo" style={`font-size: ${fontSize}`}>
  <img src="/images/heurystics-mark.svg" alt="" width={iconSize} height={iconSize} class:list={["logo-mark", { "logo-mark-light": light }]} />
  <span class="wordmark" style={`color: ${navyColor}`}>
    Heurystics
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .logo-mark {
    object-fit: contain;
  }
  .logo-mark-light {
    filter: brightness(0) invert(1);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
</style>
