---
interface Props {
  size?: 'sm' | 'md';
  light?: boolean;
}

const { size = 'md', light = false } = Astro.props;
const iconSize = size === 'sm' ? 24 : 32;
const fontSize = size === 'sm' ? '17px' : '21px';
const navyColor = light ? '#fff' : '#1B2A4A';
---

<a href="/" class="logo" style={`font-size: ${fontSize}`}>
  <svg viewBox="0 0 32 32" fill="none" width={iconSize} height={iconSize}>
    <rect x="4" y="2" width="7" height="28" rx="1" fill={navyColor} />
    <rect x="21" y="2" width="7" height="28" rx="1" fill={navyColor} />
    <rect x="8" y="8" width="18" height="5" rx="1" fill="#1B5299" transform="rotate(-20 17 10.5)" />
  </svg>
  <span class="wordmark">
    <span style={`color: ${navyColor}`}>Heurystic</span><span style="color: var(--ochre)">s</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
</style>
